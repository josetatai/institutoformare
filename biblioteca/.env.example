# Endereço público da biblioteca (sem barra no final)
APP_URL=https://biblioteca.institutoformare.com.br

# MySQL da Hostinger (no servidor use 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Token que a Kiwify mostra ao criar o webhook
KIWIFY_WEBHOOK_TOKEN=

# Envio de e-mail (caixa da Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=acesso@institutoformare.com.br
SMTP_PASSWORD=
MAIL_FROM="Biblioteca Formare <acesso@institutoformare.com.br>"

# Pasta dos livros e anexos, fora da área pública (padrão: ./storage)
STORAGE_DIR=
