{
  "name": "biblioteca-formare",
  "version": "0.1.0",
  "private": true,
  "description": "Biblioteca de e-books do Instituto Formare: leitura em flipbook, anexos e acesso integrado à Kiwify.",
  "scripts": {
    "dev": "npm run worker && next dev",
    "worker": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs",
    "prebuild": "npm run worker",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "db:migrate": "node scripts/migrate.mjs",
    "db:catalogo": "node scripts/seed-catalogo.mjs",
    "admin:criar": "node scripts/criar-admin.mjs",
    "anexos:importar": "node scripts/importar-anexos.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "mysql2": "^3.14.0",
    "next": "^15.5.0",
    "nodemailer": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
